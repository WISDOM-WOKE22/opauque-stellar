#!/usr/bin/env bash
# opaque-backup: encrypted, timestamped backups of protocol service state.
# Documented in docs/state-backups.md. Install to /usr/local/bin/opaque-backup.
#
# Usage: opaque-backup [--dry-run] [-h|--help]
#
# Environment (all optional):
#   OPAQUE_BACKUP_DIR              backup destination   (/var/backups/opaque)
#   OPAQUE_REPO_ROOT               checkout root        (/srv/opaque/stellar)
#   OPAQUE_BACKUP_PASSPHRASE_FILE  gpg passphrase file  (/etc/opaque/backup-passphrase)
#   OPAQUE_BACKUP_RETENTION_DAYS   override retention for ALL services
#                                  (defaults: asp 30, publisher 90, relayer 30)
#   ASP_DATA_DIR, PUBLISHER_DATA_DIR
#                                  override service data dirs (the same variables the
#                                  services read; default <repo>/{asp,publisher}/data)
#   RELAYER_DATA_DIR               relayer hub state dir. The hub only persists when
#                                  this is set; if unset the relayer is skipped.
set -euo pipefail
umask 077

DRY_RUN=0
for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY_RUN=1 ;;
    -h|--help) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "opaque-backup: unknown argument: $arg" >&2; exit 2 ;;
  esac
done

BACKUP_ROOT="${OPAQUE_BACKUP_DIR:-/var/backups/opaque}"
REPO_ROOT="${OPAQUE_REPO_ROOT:-/srv/opaque/stellar}"
PASSPHRASE_FILE="${OPAQUE_BACKUP_PASSPHRASE_FILE:-/etc/opaque/backup-passphrase}"
TIMESTAMP=$(date -u +"%Y%m%dT%H%M%SZ")

retention_for() {
  if [[ -n "${OPAQUE_BACKUP_RETENTION_DAYS:-}" ]]; then
    echo "$OPAQUE_BACKUP_RETENTION_DAYS"
    return
  fi
  case "$1" in
    publisher) echo 90 ;;
    *) echo 30 ;;
  esac
}

if [[ $DRY_RUN -eq 0 ]]; then
  if [[ ! -r "$PASSPHRASE_FILE" ]]; then
    echo "FAIL: passphrase file $PASSPHRASE_FILE is missing or unreadable" >&2
    exit 1
  fi
  mkdir -p "$BACKUP_ROOT"
fi

backup_service() {
  local name="$1" src="$2"
  local dest="$BACKUP_ROOT/${name}-${TIMESTAMP}.tar.gz.gpg"

  if [[ -z "$src" || ! -d "$src" ]]; then
    echo "SKIP: $name - ${src:-<no data dir configured>} does not exist"
    return 0
  fi
  if [[ $DRY_RUN -eq 1 ]]; then
    echo "DRY-RUN: would back up $name: $src -> $dest"
    return 0
  fi

  # Write to a temp name and rename so a failed run never leaves a truncated
  # file that looks like a valid backup.
  local tmp="$dest.partial"
  if tar -czf - -C "$(dirname "$src")" "$(basename "$src")" \
      | gpg --batch --yes --pinentry-mode loopback --passphrase-file "$PASSPHRASE_FILE" \
            --symmetric --cipher-algo AES256 -o "$tmp"; then
    mv "$tmp" "$dest"
  else
    rm -f "$tmp"
    echo "FAIL: $name - backup of $src failed" >&2
    return 1
  fi
  echo "OK: $name -> $dest ($(du -sh "$dest" | cut -f1))"
}

status=0
backup_service asp       "${ASP_DATA_DIR:-$REPO_ROOT/asp/data}"             || status=1
backup_service publisher "${PUBLISHER_DATA_DIR:-$REPO_ROOT/publisher/data}" || status=1
backup_service relayer   "${RELAYER_DATA_DIR:-}"                            || status=1

# Prune per service so a short-retention service never deletes another's history.
for name in asp publisher relayer; do
  days=$(retention_for "$name")
  if [[ $DRY_RUN -eq 1 ]]; then
    echo "DRY-RUN: would prune $name backups older than ${days} days"
  elif [[ -d "$BACKUP_ROOT" ]]; then
    find "$BACKUP_ROOT" -maxdepth 1 -name "${name}-*.tar.gz.gpg" -mtime "+${days}" -delete
    echo "Pruned $name backups older than ${days} days"
  fi
done

exit $status
